---
import '../styles/global.css';
import { SITE_MAPS_URL, SITE_STREET } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const siteOrigin = import.meta.env.SITE ?? 'https://serralheriaembotucatu.com.br';

const {
  title = 'Serralheria em Botucatu | Portões, Grades e Estruturas Metálicas',
  description =
    'Em Botucatu SP: portões, grades, coberturas e estruturas metálicas. Fabricação e instalação. Orçamento grátis.',
  canonical = 'https://serralheriaembotucatu.com.br',
  ogImage = '/og-image.png',
} = Astro.props;

const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage.replace(/^\//, ''), `${siteOrigin}/`).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Serralheria Botucatu',
  description:
    'Serralheria em Botucatu SP - Fabricação e instalação de portões, grades, coberturas metálicas, pergolados e estruturas metálicas.',
  url: 'https://serralheriaembotucatu.com.br',
  telephone: '+55-14-99807-4449',
  email: 'contato@serralheriaembotucatu.com.br',
  taxID: '67176250000158',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_STREET,
    addressLocality: 'Botucatu',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  hasMap: SITE_MAPS_URL,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  priceRange: '$$',
  image: absoluteOgImage,
  sameAs: ['https://www.instagram.com/serralheriaembotucatu/'],
  areaServed: {
    '@type': 'City',
    name: 'Botucatu',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços de Serralheria',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Portões de Ferro' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Cobertura Metálica' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Grades e Cercas' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Manutenção de Serralheria' } },
    ],
  },
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth selection:bg-spark-500/30 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {import.meta.env.PROD && (
      <>
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-K5M4J8KTFF"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-K5M4J8KTFF');
        </script>

        <!-- Smartlook -->
        <script is:inline>
          window.smartlook||(function(d) {
            var o=smartlook=function(){ o.api.push(arguments)},h=d.getElementsByTagName('head')[0];
            var c=d.createElement('script');o.api=new Array();c.async=true;c.type='text/javascript';
            c.charset='utf-8';c.src='https://web-sdk.smartlook.com/recorder.js';h.appendChild(c);
            })(document);
            smartlook('init', 'ca7dee2204b060448553cdec356c1eb9bc193aef', { region: 'eu' });
        </script>
      </>
    )}

    <!-- Rastreamento de cliques no WhatsApp -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest('a[href*="wa.me"]');
        if (!a) return;
        var code = 'NK-' + Date.now().toString(36).slice(-4).toUpperCase()
                 + Math.random().toString(36).slice(2, 4).toUpperCase();
        var url = new URL(a.href);
        var base = (url.searchParams.get('text') || '').replace(/\n*Código: #NK-\w+$/, '');
        url.searchParams.set('text', base + '\n\nCódigo: #' + code);
        a.href = url.toString();
        if (window.gtag) gtag('event', 'whatsapp_click', {
          lead_code: code,
          botao: a.id || a.innerText.trim().slice(0, 40),
          pagina: location.pathname
        });
        if (window.smartlook) smartlook('track', 'whatsapp_click', {
          lead_code: code,
          botao: a.id || a.innerText.trim().slice(0, 40)
        });
      });
    </script>

    <!-- Fallback inline: garante cores visíveis mesmo sem CSS externo (Googlebot) -->
    <style is:inline>
      body { background-color: #ffffff !important; }
      header { background-color: #ffffff !important; }
      #hero { background-color: #ffffff !important; }
      #servicos { background-color: #f5f5f5 !important; }
      #sobre { background-color: #ffffff !important; }
      #contato { background-color: #f5f5f5 !important; }
      footer, #localizacao { background-color: #18181b !important; }
      h1, h2, h3, p, li, a, span { color: #1a1a1a !important; }
      footer h1, footer h2, footer h3, footer p, footer li, footer a, footer span { color: #ffffff !important; }
      .on-dark, .on-dark h1, .on-dark h2, .on-dark h3, .on-dark p, .on-dark li, .on-dark a, .on-dark span { color: #ffffff !important; }
      .on-dark-text h1, .on-dark-text h2, .on-dark-text h3, .on-dark-text p { color: #ffffff !important; }
    </style>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Serralheria Botucatu" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Serralheria Botucatu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- Fonts (link direto — evita @import bloquear renderização para crawlers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#b45309" />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-base">
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>
    <slot />
  </body>
</html>
